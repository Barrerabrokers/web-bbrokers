{
  "buildCommand": "node scripts/vercel-build-checks.cjs && npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/meta-leads",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/crm-email-notifications",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/crm-client-campaigns",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/crm-device-notifications",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/whatsapp-ai-retry",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/mia-sales-pilot",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/development-drive-sync",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "app/api/upload/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
