# NextAuth
NEXTAUTH_SECRET="genera-uno-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# Conexion directa a Postgres para operaciones administrativas
# Usa la connection string pooler o non-pooling de Supabase.
DATABASE_URL="postgresql://postgres.tu-proyecto:password@aws-0-region.pooler.supabase.com:6543/postgres"

# Notificaciones de consultas por email
# Requiere una API key de https://resend.com
RESEND_API_KEY="re_xxxxxxxxx"
CONTACT_EMAIL_TO="info@barrerabrokers.com"
CONTACT_EMAIL_FROM="Barrera Brokers <consultas@barrerabrokers.com>"
AUTH_EMAIL_FROM="Barrera Brokers <accesos@barrerabrokers.com>"
NEXT_PUBLIC_SITE_URL="https://barrerabrokers.com"

# HubSpot CRM
# Crear un token de Private App con permisos de lectura de contactos, owners y propiedades.
HUBSPOT_ACCESS_TOKEN="pat-na1-xxxxxxxx"
HUBSPOT_OWNER_EMAIL="pablo@barrerabrokers.com"
CRM_PABLO_AGENT_EMAIL="pablo@barrerabrokers.com"
# Opcional: si ya tenés el owner id exacto de Pablo en HubSpot.
# HUBSPOT_PABLO_OWNER_ID="123456789"

# Google OAuth para CRM: Gmail + Google Calendar por agente
# Crear un OAuth Client Web en Google Cloud y agregar este redirect autorizado.
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"
GOOGLE_REDIRECT_URI="https://barrerabrokers.com/api/crm/google/callback"
# WhatsApp Business Platform + agente IA
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
META_DEFAULT_AGENT_EMAIL=pablo@barrerabrokers.com
OPENAI_API_KEY=
OPENAI_WHATSAPP_MODEL=gpt-5.4
OPENAI_CRM_MODEL=gpt-5.4
WHATSAPP_AI_INSTRUCTIONS=
GROQ_API_KEY=
GROQ_CRM_MODEL=openai/gpt-oss-120b
